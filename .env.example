DATABASE_URL="sqlite:///./aishorts.db"

# Configurazioni
GPU_CONFIG_PATH="configs/gpu.yaml"
MODELS_CONFIG_PATH="configs/models.yaml"
PATHS_CONFIG_PATH="configs/paths.yaml"

# HuggingFace Configuration
HF_TOKEN="your_huggingface_token"

# LLM Configuration
# Scegli il provider: "openai", "ollama" o "llama_cpp"
LLM_PROVIDER="llama_cpp"

# Configurazione OpenAI (usata se LLM_PROVIDER="openai")
OPENAI_API_BASE="https://api.openai.com/v1"
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL_NAME="gpt-3.5-turbo"

# Configurazione Ollama (usata se LLM_PROVIDER="ollama")
OLLAMA_API_BASE="http://localhost:11434/v1"
OLLAMA_API_KEY="ollama"
OLLAMA_MODEL_NAME="llama3"

# Configurazione llama.cpp (usata se LLM_PROVIDER="llama_cpp")
LLAMA_CPP_MODEL_PATH="/opt/models/Huihui-Qwen3-Omni-30B-A3B-Instruct-abliterated.i1-Q6_K.gguf"
LLAMA_CPP_PARAMS="--cache-type-k q4_0 --cache-type-v q4_0 --flash-attn on -c 4096 -t 16 -ngl 999 -b 256 -ub 128 --temp 0.5 --top-p 0.9 --top-k 40 --repeat-penalty 1.08"

# Social Media Configuration
TIKTOK_ACCESS_TOKEN="your_tiktok_access_token"
YOUTUBE_API_KEY="your_youtube_api_key"
FACEBOOK_ACCESS_TOKEN="your_facebook_access_token"
INSTAGRAM_ACCESS_TOKEN="your_instagram_access_token"

# Server Host Configuration
BACKEND_HOST="0.0.0.0"
BACKEND_PORT="8000"
FRONTEND_HOST="0.0.0.0"
FRONTEND_PORT="3000"

# Scheduler Configuration
SCHEDULER_INTERVAL_MINUTES="30"
ENABLE_SCHEDULER_ON_BOOT="true"

# PyTorch CUDA Memory Allocation
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Generation Parameters
GEN_WIDTH=256
GEN_HEIGHT=448
GEN_FRAMES=49
GEN_FLUX_STEPS=4
GEN_WAN_STEPS=30
GEN_LTX_STEPS=50

# Video Provider Configuration
DEFAULT_VIDEO_PROVIDER=wan

# Subtitle Generation
GENERATE_SUBTITLES=false
