# Database
DATABASE_URL="sqlite:///./aishorts.db"

# Configurazioni
GPU_CONFIG_PATH="configs/gpu.yaml"
MODELS_CONFIG_PATH="configs/models.yaml"
PATHS_CONFIG_PATH="configs/paths.yaml"

# LLM Configuration
# Scegli il provider: "openai" o "ollama"
LLM_PROVIDER="ollama"

# Configurazione OpenAI (usata se LLM_PROVIDER="openai")
OPENAI_API_BASE="https://api.openai.com/v1"
OPENAI_API_KEY="your_openai_api_key"
OPENAI_MODEL_NAME="gpt-3.5-turbo"

# Configurazione Ollama (usata se LLM_PROVIDER="ollama")
OLLAMA_API_BASE="http://localhost:11434/v1"
OLLAMA_API_KEY="ollama" # Opzionale, Ollama di solito non la richiede ma il client ne ha bisogno
OLLAMA_MODEL_NAME="llama3"

# Social Media Configuration
TIKTOK_ACCESS_TOKEN="your_tiktok_access_token"
YOUTUBE_API_KEY="your_youtube_api_key"
FACEBOOK_ACCESS_TOKEN="your_facebook_access_token"
INSTAGRAM_ACCESS_TOKEN="your_instagram_access_token"

# Server Host Configuration
BACKEND_HOST="0.0.0.0"
BACKEND_PORT="8000"
FRONTEND_HOST="0.0.0.0"
FRONTEND_PORT="3000"
